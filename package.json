{
  "name": "jobsieve",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import": "tsx scripts/import-sqlite.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "format": "prettier --write app lib ui scripts tests *.ts *.json *.md"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.4",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.103.0",
    "axios": "^1.20.0",
    "dompurify": "^3.4.15",
    "html-react-parser": "^6.1.7",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.0",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.36",
    "@next/env": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "better-sqlite3": "^13.0.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
